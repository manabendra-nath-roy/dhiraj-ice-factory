# Client-side fallback (used when /api/partner-application is unavailable)
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_API_KEY=your_web_api_key

# Vercel serverless API (recommended for production)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_API_KEY=your_web_api_key

# Optional aliases (if your existing keys use these names)
# VITE_FIREBASE_PROJECTID=your_project_id
# VITE_FIREBASE_WEB_API_KEY=your_web_api_key

# Admin portal login (for /admin page)
ADMIN_PORTAL_ID=admin_id_here
ADMIN_PORTAL_PASSWORD=strong_password_here

# Telegram notification (optional but recommended)
TELEGRAM_BOT_TOKEN=telegram_bot_token_here
TELEGRAM_CHAT_ID=telegram_chat_id_here
